name: Publish APK
on:
  push:
    branches: [main, feature/security-hardening]
  workflow_dispatch:
permissions:
  contents: write
concurrency:
  group: publish-apk
  cancel-in-progress: true
env:
  FLUTTER_VERSION: "3.29.3"
jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with:
          flutter-version: ${{ env.FLUTTER_VERSION }}
          channel: stable
          cache: true
      - run: flutter pub get
      - run: flutter build apk --debug
      - run: cp build/app/outputs/flutter-apk/app-debug.apk Lantern.apk
      - name: Replace the rolling release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh release delete latest-build --cleanup-tag --yes || true
          gh release create latest-build Lantern.apk \
            --prerelease \
            --target "$GITHUB_SHA" \
            --title "Lantern (latest build)" \
            --notes "Debug APK from $GITHUB_SHA on $GITHUB_REF_NAME."
